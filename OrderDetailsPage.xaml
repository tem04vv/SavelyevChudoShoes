<Page x:Class="SavelyevShoes.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SavelyevShoes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderDetailsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Состав заказа" Grid.Row="0" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Номер Заказа: " Grid.Row="0" FontSize="15" HorizontalAlignment="Left" Margin="5"></TextBlock>
            <TextBlock Text="Дата Заказа: " Grid.Row="1" FontSize="15" HorizontalAlignment="Left" Margin="5"></TextBlock>
            <TextBlock Text="Клиент: " Grid.Row="2" FontSize="15" HorizontalAlignment="Left" Margin="5"></TextBlock>

            <TextBlock Name="OrderNumberTB" Grid.Column="1" Grid.Row="0" FontSize="15" HorizontalAlignment="Left" Margin="5"></TextBlock>
            <TextBlock Name="OrderDateTB" Grid.Column="1" Grid.Row="1" FontSize="15" HorizontalAlignment="Left" Margin="5"></TextBlock>
            <TextBlock Name="ClientNameTB" Grid.Column="1" Grid.Row="2" FontSize="15" HorizontalAlignment="Left" Margin="5"></TextBlock>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="155"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Наименование товара" Grid.Column="0" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="Размер" Grid.Column="1" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="Количество" Grid.Column="2" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="Цена за единицу" Grid.Column="3" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="Сумма по строке" Grid.Column="4" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
          
        </Grid>
        <ListView Grid.Row="3" Name="OrderDetailsListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="550"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="155"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StockItem.Product.ProductName}" Grid.Column="0" FontSize="17" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                        <TextBlock Text="{Binding StockItem.Size.SizeDisplay}" Grid.Column="1" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <TextBlock Text="{Binding Quantity}" Grid.Column="2" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <TextBlock Text="{Binding StockItem.Product.Price, StringFormat={}{0} руб.}" Grid.Column="3" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0} руб.}" Grid.Column="4" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <Button Content="+" Name="AddCountBtn" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="30" Click="AddCountBtn_Click"></Button>
                        <TextBlock Text="Изменить кол-во" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Grid.Column="6"></TextBlock>
                        <Button Content="-" Name="SubtractCountBtn" Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="30" Click="SubtractCountBtn_Click"></Button>
                        <Button Background="Red" Width="110" Content="Удалить" Name="DeleteBtn" Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Click="DeleteBtn_Click"></Button>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Name="TotalSumTB" Grid.Row="4" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Margin="5" VerticalAlignment="Center"></TextBlock>
    </Grid>
</Page>