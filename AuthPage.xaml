<Page x:Class="SavelyevShoes.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SavelyevShoes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Авторизация" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Логин" FontSize="25" HorizontalAlignment="Left" Margin="5,0,0,0"></TextBlock>
        <TextBox Name="LoginTextBox" Grid.Row="2" Grid.Column="1" Width="360" Height="25" HorizontalAlignment="Left" Margin="5,0,0,0"></TextBox>
        <Button Name="GuestBtn" Content="Войти как гость" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="5,0,0,0" Click="GuestBtn_Click"></Button>
        <Button Name="SaveBtn" Content="Сохранить" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,5,0" Click="SaveBtn_Click"></Button>
    </Grid>
</Page>
