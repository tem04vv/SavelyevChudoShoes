<Window x:Class="SavelyevShoes.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SavelyevShoes"
        mc:Ignorable="d"
        Title="OrderWindow" Height="450" Width="900" FontFamily="Calibri">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата заказа:" FontSize="17" Margin="5"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="ФИО клиента:" FontSize="17" Margin="5"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Номер заказа:" FontSize="17" Margin="5"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Итого:" FontSize="17" Margin="5" FontWeight="Bold"/>

            <TextBlock Grid.Row="0" Grid.Column="1" Name="OrderDateTB" FontSize="17" Margin="5"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Name="UserNameTB" FontSize="17" Margin="5"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="OrderNumberTB" FontSize="17" Margin="5"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Name="TotalTB" FontSize="17" Margin="5" FontWeight="Bold"/>
        </Grid>

        <ListView Grid.Row="1" Name="ItemsListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="428"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding StockItem.Product.ProductName}" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StockItem.Size.SizeDisplay, StringFormat=Размер: {0}}" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat=Кол-во: {0}}" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding StockItem.Product.Price, StringFormat={}{0} руб.}" FontWeight="DemiBold" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <Button Grid.Column="4" Content="+" Name="AddQuantityBtn" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="AddQuantityBtn_Click"></Button>
                        <TextBlock Grid.Column="5" Text="Изменить кол-во" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="6" Content="-" Name="DeleteQuantityBtn" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="DeleteQuantityBtn_Click"></Button>
                        <Button Grid.Column="7" Content="Удалить" Name="DeleteOrderBtn" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Click="DeleteOrderBtn_Click"></Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2" Name="SaveBtn" Content="Сохранить заказ" Click="SaveBtn_Click" Width="200" HorizontalAlignment="Right" Margin="5"/>
    </Grid>
</Window>
