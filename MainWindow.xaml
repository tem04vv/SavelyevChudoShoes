<Window x:Class="SavelyevShoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SavelyevShoes"
        mc:Ignorable="d"
        Title="Чудо Обувь" Height="450" Width="900" FontFamily="Calibri" Icon="res/Чудо Обувь.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#D2F6E7">
            <Image Source="/Чудо Обувь.png" HorizontalAlignment="Left"></Image>
            <TextBlock Text="Чудо обувь" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <Button Content="Назад" Name="BtnBack" HorizontalAlignment="Right" Margin="5" Click="BtnBack_Click"></Button>
        </Grid>
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
